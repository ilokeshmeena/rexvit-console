{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RexVit Console",
  "version": "0.1.0",
  "identifier": "com.rexvit.console",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RexVit Console",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi", "nsis"],
    "icon": []
  }
}
